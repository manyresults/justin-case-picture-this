# --- Server (Vercel env var; NEVER prefix with VITE_) ---
GEMINI_API_KEY=
# GoHighLevel workflow Inbound Webhook URL (leads are forwarded server-side)
GHL_WEBHOOK_URL=

# --- Client (optional) ---
# Where "Get a Quote" buttons go. Falls back to the footer contact section.
VITE_QUOTE_URL=
# Shown in the footer if set, e.g. (215) 555-0100
VITE_PHONE=
# Optional: embed your existing form (e.g. a FunnelZai/GoHighLevel widget URL) instead of the built-in lead form
VITE_LEAD_FORM_URL=
